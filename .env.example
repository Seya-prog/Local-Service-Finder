# Better Auth Configuration
BETTER_AUTH_SECRET=local-service-finder-dev-secret-change-in-production
BETTER_AUTH_URL=http://localhost:3000

# Vercel Postgres / Neon Database Configuration
# Automatically injected when linked to Vercel Postgres in the Vercel dashboard:
# vercel env pull .env.local
POSTGRES_URL="postgres://default:default@ep-empty.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
DATABASE_URL="postgres://default:default@ep-empty.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
